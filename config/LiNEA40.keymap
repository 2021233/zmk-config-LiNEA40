#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 1
#define MARK 2
#define CURSOR 3
#define FUNCTION 4
#define SCROLL 5
#define WIRELESS 6

//mouse cursol

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

//mouse scroll

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

&msc_input_listener {
    speed_up {
        layers = <FUNCTION>;
        input-processors = <&zip_wheel_scaler 3 1>; //スクロールを3倍速にする
    };
};

&trackball_listener {
    scroller {
        layers = <SCROLL>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            //スクロール方向を逆転,,,,,
            <&zip_xy_to_scroll_mapper>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        ZenkakuHankaku {
            bindings = <&kp GRAVE>;
            key-positions = <11 12>;
        };

        DeleteKey {
            bindings = <&kp DEL>;
            key-positions = <7 8>;
        };

        InsertKey {
            bindings = <&kp INS>;
            key-positions = <6 7>;
        };

        CenterClick {
            bindings = <&mkp MB3>;
            key-positions = <17 16>;
        };

        RightClick {
            bindings = <&mkp MB2>;
            key-positions = <18 17>;
        };

        PrevClick {
            bindings = <&mkp MB4>;
            key-positions = <27 28>;
        };

        ClickNext {
            bindings = <&mkp MB5>;
            key-positions = <26 27>;
        };
    };

    behaviors {
        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        cmt: custom_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "CUSTOM_MOD_TAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <160>;
            quick-tap-ms = <150>;
            flavor = "tap-preferred";
        };

        clt: custom_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "CUSTOM_LAYER_TAP";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <160>;
            quick-tap-ms = <150>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            bindings = <
&none                &none              &none                &none             &none                         &none         &none             &none                 &none               &none
&none                &cmt LEFT_SHIFT W  &cmt LEFT_CONTROL E  &cmt LEFT_ALT T   &none                         &none         &cmt RIGHT_ALT Y  &cmt RIGHT_CONTROL N  &cmt RIGHT_SHIFT M  &none
&cmt LEFT_GUI LC(A)  &kp S              &kp D                &kp G             &none                         &none         &kp H             &kp J                 &kp K               &cmt RIGHT_GUI L
&none                &none              &none                &clt 4 BACKSPACE  &clt 2 SPACE  &none    &none  &clt 1 ENTER                    &none                 &none               &none
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        number_cursor {
            bindings = <
&trans            &trans                    &trans                      &trans                  &trans                        &trans         &trans                   &trans             &trans                     &trans
&trans            &cmt LEFT_SHIFT NUMBER_1  &cmt LEFT_CONTROL NUMBER_2  &cmt LEFT_ALT NUMBER_3  &trans                        &trans         &cmt RIGHT_ALT NUMBER_4  &cmt RIGHT_ALT N5  &cmt RIGHT_SHIFT NUMBER_6  &trans
&cmt LEFT_GUI N7  &kp N8                    &kp N9                      &kp N0                  &trans                        &trans         &kp LEFT_ARROW           &kp DOWN_ARROW     &kp UP_ARROW               &cmt RIGHT_GUI RIGHT_ARROW
&trans            &trans                    &trans                      &kp DELETE              &clt 2 TAB  &trans    &trans  &clt 1 ESCAPE                           &trans             &trans                     &trans
            >;

            sensor-bindings = <&inc_dec_kp K_VOLUME_UP K_VOLUME_DOWN>;
        };

        function {
            bindings = <
&trans            &trans              &trans                &trans            &trans                        &trans         &trans             &trans                 &trans               &trans
&trans            &cmt LEFT_SHIFT F1  &cmt LEFT_CONTROL F2  &cmt LEFT_ALT F3  &trans                        &trans         &cmt RIGHT_ALT F4  &cmt RIGHT_CONTROL F5  &cmt RIGHT_SHIFT F6  &trans
&cmt LEFT_GUI F7  &kp F8              &kp F9                &kp F10           &trans                        &trans         &kp PAGE_UP        &kp PAGE_DOWN          &kp HOME             &cmt RIGHT_GUI END
&trans            &trans              &trans                &kp DELETE        &clt 2 TAB  &trans    &trans  &clt 1 ESCAPE                     &trans                 &trans               &trans
            >;

            sensor-bindings = <&inc_dec_kp K_VOLUME_UP K_VOLUME_DOWN>;
        };

        media {
            bindings = <
&trans  &trans          &trans            &trans        &trans                    &trans  &trans             &trans      &trans           &trans
&trans  &kp K_PREVIOUS  &kp K_PLAY_PAUSE  &kp K_NEXT    &trans                    &trans  &none              &none       &none            &trans
&none   &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT    &trans                    &trans  &kp K_VOLUME_DOWN  &kp K_MUTE  &kp K_VOLUME_UP  &none
&trans  &trans          &trans            &kp CAPSLOCK  &none   &trans    &trans  &mo 5                      &trans      &trans           &trans
            >;
        };

        mouse {
            bindings = <
&trans        &trans          &trans            &trans        &trans                    &trans     &trans    &trans    &trans    &trans
&trans        &kp LEFT_SHIFT  &kp LEFT_CONTROL  &kp LEFT_ALT  &trans                    &trans     &mkp MB4  &mkp MB3  &mkp MB5  &trans
&kp LEFT_GUI  &none           &none             &none         &trans                    &trans     &mkp MB1  &mkp MB2  &none     &none
&trans        &trans          &trans            &kp CAPSLOCK  &none   &trans    &trans  &kp ENTER            &trans    &trans    &trans
            >;
        };

        ble {
            bindings = <
&trans  &trans        &trans        &trans        &trans                    &trans  &trans        &trans        &trans  &trans
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans                    &trans  &bt BT_SEL 3  &bt BT_SEL 4  &none   &trans
&none   &none         &none         &none         &trans                    &trans  &none         &none         &none   &none
&trans  &trans        &trans        &bt BT_CLR    &none   &trans    &trans  &none                 &trans        &trans  &trans
            >;
        };

        //1
        //2
        //3
        //4
        //5
        //6
    };
};
